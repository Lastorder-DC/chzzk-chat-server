# 치지직 개발자 센터(https://developers.chzzk.naver.com/application)에서 발급
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# OAuth 콜백 URL (치지직 개발자 센터에 등록한 로그인 리디렉션 URL과 일치해야 함)
REDIRECT_URI=http://localhost:3000/auth/callback

# 서버 포트 (기본값: 3000)
PORT=3000

# CORS 허용 오리진 (쉼표로 구분, 미설정시 모든 오리진 허용)
# 예: ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_ORIGINS=

# 리버스 프록시 신뢰 설정 (nginx 등 앞에 두는 경우 1로 설정, 기본값: 1)
# nginx 없이 직접 서비스하는 경우 0으로 설정
TRUST_PROXY=1
